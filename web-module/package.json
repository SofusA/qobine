{
  "scripts": {
    "build": "tailwindcss -i assets/tailwind.css -o assets/styles.css --minify",
    "watch": "tailwindcss -i assets/tailwind.css -o assets/styles.css --watch --minify",
    "format": "prettier -w \"**/*.html\" --parser angular",
    "format:check": "prettier -w \"**/*.html\" --parser angular --check",
    "build-assets": "pwa-asset-generator -m assets/manifest.json -i dummy-index.html -b black assets/favicon.svg assets/pwa"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pwa-asset-generator": "^8.1.7",
    "tailwindcss": "^4.3.5",
    "tailwindcss-safe-area": "^2.0.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
